{
  "rules": {
    "rooms": {
      "$room": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'createdAt'])"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() ? root.child('rooms').child($room).child('players').numChildren() < 2 : true)"
          }
        },
        "shared": {
          ".read": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
        }
      }
    }
  }
}
